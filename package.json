{
  "name": "xiaoke-go",
  "productName": "小柯機器人圍棋競賽",
  "version": "1.0.0",
  "description": "小柯機器人圍棋競賽：3D 圍棋（9／13／19 路；真人對 AI、真人對真人〔本機或遠端＋語音〕、AI 對 AI；內建 KataGo 引擎即時勝率、AI 軍師代打、棋譜庫與覆盤速算、動畫語音教學、背景音樂、自動更新）",
  "main": "src/main/main.js",
  "author": {
    "name": "吳玉柱",
    "email": "achir1015@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "e2e": "node e2e/smoke.mjs",
    "music": "python scripts/gen_music.py",
    "icon": "python scripts/make_icon.py",
    "portraits": "node scripts/gen_portraits.mjs",
    "engine": "node scripts/fetch-engine.mjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "peerjs": "1.5.5",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.achir.xiaokego",
    "productName": "小柯機器人圍棋競賽",
    "artifactName": "XiaokeGo-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 吳玉柱",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/icon.png",
      "!assets/portraits/_sheet.html",
      "package.json",
      "node_modules/**/*",
      "!node_modules/three/examples/**",
      "!node_modules/three/src/**",
      "!node_modules/**/test/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts",
      "!engine/**",
      "!e2e/**",
      "!scripts/**",
      "!test/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "XiaokeGo"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小柯機器人圍棋競賽",
      "uninstallDisplayName": "小柯機器人圍棋競賽",
      "language": "1028",
      "installerLanguages": [
        "zh_TW"
      ]
    },
    "portable": {
      "artifactName": "XiaokeGo-${version}-win-x64-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.board-games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "與遠端棋友語音通話需要使用麥克風。"
      },
      "identity": "-"
    },
    "dmg": {
      "title": "小柯機器人圍棋競賽 ${version}"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "peer": "^1.0.2",
    "playwright-core": "^1.48.2"
  }
}
